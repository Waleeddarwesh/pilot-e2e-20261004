# Generated by EgyKode Pilot (https://egykode.com) — review before merging.
# This file is a starting point, not a finished production configuration.
# Whether there is a build step, where it writes, and how the app starts are all read from
# package.json. None of the three is assumed.

FROM node:20-alpine AS deps
WORKDIR /app
COPY package*.json ./
# The mkdir is not redundant: with no production dependencies — normal for a service whose
# bundler inlines everything — an install that omits them creates no node_modules at all, and
# the COPY in the runtime stage then fails with "/app/node_modules: not found".
RUN npm ci --omit=dev && npm cache clean --force && mkdir -p /app/node_modules

FROM node:20-alpine AS runtime
ENV NODE_ENV=production PORT=3000
WORKDIR /app
# Every command this image can run starts node directly, so the npm bundled in the base image
# never runs here; it is removed with the vulnerabilities an image scan finds in it (G0,
# 2026-10-01: 10 of 11). apk upgrade takes the base's security fixes released since the tag was
# built (2026-10-04: OpenSSL 3.5.6, two HIGH, fixed in 3.5.7 and 3.5.8).
RUN apk upgrade --no-cache && apk add --no-cache curl tini && addgroup -S app && adduser -S app -G app \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
COPY --from=deps  --chown=app:app /app/node_modules ./node_modules
# package.json declares no build script, so the source is the artifact and is copied as
# it is. .dockerignore keeps node_modules and build noise out of the context.
COPY --chown=app:app . .
# AWS's global RDS authority, which the task's DB_CA_BUNDLE names. It rotates; the build date records which one.
ADD --chmod=0644 https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem /etc/ssl/certs/rds-global-bundle.pem
USER app
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD curl -fsS http://localhost:3000/health || exit 1
# tini as PID 1: Linux gives PID 1 no default signal handling, so node there ignored SIGTERM and
# every stop waited out the grace period and ended in SIGKILL (measured: 30.4 s, exit 137; with
# tini 0.4 s, exit 143). It forwards signals and reaps children; the command is unchanged.
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node","server.js"]
