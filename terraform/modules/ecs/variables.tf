variable "name" {
  type = string
}

variable "permissions_boundary_arn" {
  type        = string
  default     = null
  description = "The permissions boundary every role here carries: the bootstrap's workload boundary. The deploy role creates no role without it."
}

variable "iam_path" {
  type        = string
  default     = "/"
  description = "The IAM path of every role, policy and instance profile here: /pilot/<project>/, the only path the pipeline's deploy role may manage."
}

variable "region" {
  type    = string
  default = "us-east-1"
}

variable "vpc_id" {
  type = string
}

variable "private_subnet_ids" {
  type = list(string)
}

variable "public_subnet_ids" {
  type = list(string)
}

variable "container_port" {
  type = number
}

variable "health_check_path" {
  description = "Static HTTP health route. Use / with a broad matcher only when no route is proven."
  type        = string
}

variable "health_check_matcher" {
  description = "ALB success codes for the health route."
  type        = string
  default     = "200-399"
}

variable "cpu_architecture" {
  description = "Processor architecture of the image published by the generated pipeline."
  type        = string

  validation {
    condition     = contains(["X86_64", "ARM64"], var.cpu_architecture)
    error_message = "cpu_architecture must be X86_64 or ARM64."
  }
}

variable "image" {
  description = <<-EOT
    Placeholder the task definition is created with, never the application.

    The service has to exist before an image can be deployed to it, and the image is built by
    the pipeline that runs after this applies -- so the first apply has nothing real to point
    at. It creates the service with zero tasks (see initial_desired_count), so this image is
    never started and never answers a request. Delivery registers a revision holding the image
    it built and scales the service up.
  EOT
  type        = string
  default     = "public.ecr.aws/nginx/nginx:latest"
}

variable "initial_desired_count" {
  description = <<-EOT
    Tasks the service is created with. Zero, so no placeholder ever serves traffic.

    Only the initial value: desired_count is ignored after creation because delivery owns it,
    and Terraform re-asserting it would fight every deployment and every autoscaling decision.
  EOT
  type        = number
  default     = 0
}

variable "certificate_arn" {
  description = "ACM certificate for the HTTPS listener. Empty means the load balancer serves plain HTTP, which is not a production configuration."
  type        = string
  default     = ""
}

variable "environment" {
  description = "Non-secret values the workload reads, by variable name."
  type        = map(string)
