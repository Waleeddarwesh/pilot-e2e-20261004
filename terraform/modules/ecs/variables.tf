}

variable "secrets" {
  description = "Secrets Manager ARNs the workload reads, by variable name. May carry a JSON key."
  type        = map(string)
  default     = {}
}

variable "desired_count" {
  type = number
}

variable "max_count" {
  type = number
}

variable "task_cpu" {
  type = number
}

variable "task_memory" {
  type = number
}

variable "worker_enabled" {
  description = <<-EOT
    Whether this repository has a background workload to run.

    False creates none of the worker resources. Separate from the command below because a
    workload built from its own Dockerfile needs no command override -- that image's CMD is
    already what it runs.
  EOT
  type        = bool
  default     = false
}

variable "worker_command" {
  description = <<-EOT
    The command that overrides the image's own, where the worker shares the service's image.

    The command the repository declares -- a Procfile line, a package script -- not a guess from
    a queue library name. Empty means the image starts the right process on its own, which is
    the case when this workload has its own Dockerfile.
  EOT
  type        = list(string)
  default     = []
}

variable "worker_desired_count" {
  description = "Worker tasks this architecture is sized and priced for. Delivery scales to it."
  type        = number
  default     = 0
}

