# Generated by EgyKode Pilot (https://egykode.com) — review before merging.
# This file is a starting point, not a finished production configuration.
# ECS on Fargate behind an Application Load Balancer. No nodes to patch.

resource "aws_ecs_cluster" "this" {
  name = var.name

  setting {
    name  = "containerInsights"
    value = "enabled"
  }

  depends_on = [aws_cloudwatch_log_group.insights]
}

# Container Insights writes here. Left to AWS, the group is created outside Terraform once a task
# runs and outlives every destroy (REVIEW-DC373BC finding 6); created first, it is Terraform's.
resource "aws_cloudwatch_log_group" "insights" {
  name              = "/aws/ecs/containerinsights/${var.name}/performance"
  retention_in_days = 1
}

resource "aws_security_group" "alb" {
  name        = "${var.name}-alb"
  description = "Public ingress"
  vpc_id      = var.vpc_id

  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
    description = "Redirected to 443"
  }

}

# A load balancer forwards to its targets and calls nothing else. This was every protocol to
# every address, which trivy reports as AWS-0104 and which nothing here needs: the tasks are in
# the same module, so the rule can name them.
#
# A separate resource rather than an inline egress block inside the group above. The task
# group's ingress already names the load balancer, so naming the task group from inside the
# load balancer makes the two definitions depend on each other and Terraform refuses the graph:
#
#   Error: Cycle: module.service.aws_security_group.alb, module.service.aws_security_group.task
#
# A rule that references both, and is referenced by neither, has no such cycle.
resource "aws_vpc_security_group_egress_rule" "alb_to_tasks" {
  security_group_id            = aws_security_group.alb.id
  referenced_security_group_id = aws_security_group.task.id
  ip_protocol                  = "tcp"
  from_port                    = var.container_port
  to_port                      = var.container_port
  description                  = "Forward to the tasks behind this load balancer"
}

resource "aws_security_group" "task" {
  # AWS refuses anything but ASCII in a security group description: an em dash here failed the
  # first real apply (CreateSecurityGroup, InvalidParameterValue).
  name        = "${var.name}-task"
  description = "Application tasks - reachable only from the load balancer"
  vpc_id      = var.vpc_id

  ingress {
    from_port       = var.container_port
    to_port         = var.container_port
    protocol        = "tcp"
    security_groups = [aws_security_group.alb.id]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

# The load balancer's and target group's names: at most 32 characters, not ending in a hyphen, and a
# load balancer's not starting "internal-". A name that met that keeps it. One that did not, which
# AWS refused, is cut and ends in a hash of the whole name: trimmed instead, a 31-character project
# got the same name in every environment (REVIEW-1A0DAB6 findings 5 and 6).
resource "aws_lb" "this" {
  name               = can(regex("^internal-", var.name)) || endswith(substr(var.name, 0, 32), "-") ? "${replace(substr(replace(var.name, "/^internal-/", "int-"), 0, 23), "/-+$/", "")}-${substr(sha1(var.name), 0, 8)}" : substr(var.name, 0, 32)
  load_balancer_type = "application"
  subnets            = var.public_subnet_ids
  security_groups    = [aws_security_group.alb.id]

  drop_invalid_header_fields = true
}

resource "aws_lb_target_group" "this" {
  name        = endswith(substr("${var.name}-tg", 0, 32), "-") ? "${replace(substr(var.name, 0, 20), "/-+$/", "")}-${substr(sha1(var.name), 0, 8)}-tg" : substr("${var.name}-tg", 0, 32)
  port        = var.container_port
  protocol    = "HTTP"
  target_type = "ip"
  vpc_id      = var.vpc_id

  health_check {
    path                = var.health_check_path
    matcher             = var.health_check_matcher
    interval            = 15
    healthy_threshold   = 2
    unhealthy_threshold = 2
  }

  deregistration_delay = 30
}

# Ingress, which has to reach the application.
#
# There was one listener here: port 80 redirecting to port 443, and no 443 listener and no
# forwarding action anywhere. Creating a target group does not attach it to anything, so every
# request was answered by a redirect to a port with nothing on it. The health check that "proved"
# the deployment accepted that redirect as success.
#
# TLS needs a certificate and a domain, and neither can be invented here. So the shape depends on
# whether one was supplied, and the case where none was is labelled rather than silently treated
# as a production deployment.

# No certificate: the listener forwards. Plain HTTP, which is honest for a preview environment
# and is reported as a caveat rather than presented as production-ready.
resource "aws_lb_listener" "http" {
  count = var.certificate_arn == "" ? 1 : 0

  load_balancer_arn = aws_lb.this.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.this.arn
  }
}

# A certificate was supplied: port 80 redirects, and 443 terminates TLS and forwards.
resource "aws_lb_listener" "http_redirect" {
  count = var.certificate_arn == "" ? 0 : 1

  load_balancer_arn = aws_lb.this.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type = "redirect"
    redirect {
      port        = "443"
      protocol    = "HTTPS"
      status_code = "HTTP_301"
    }
  }
}

resource "aws_lb_listener" "https" {
  count = var.certificate_arn == "" ? 0 : 1

  load_balancer_arn = aws_lb.this.arn
  port              = 443
  protocol          = "HTTPS"
  # A current policy rather than the AWS default, which still permits TLS 1.0.
  ssl_policy      = "ELBSecurityPolicy-TLS13-1-2-2021-06"
  certificate_arn = var.certificate_arn

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.this.arn
  }
}

data "aws_iam_policy_document" "task_assume" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["ecs-tasks.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "execution" {
  name                 = "${var.name}-execution"
  permissions_boundary = var.permissions_boundary_arn
  path                 = var.iam_path
  assume_role_policy   = data.aws_iam_policy_document.task_assume.json
}

resource "aws_iam_role_policy_attachment" "execution" {
  role       = aws_iam_role.execution.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"

  lifecycle {
    replace_triggered_by = [aws_iam_role.execution.unique_id]
  }
}

# The managed policy above does not grant Secrets Manager access, so a task definition naming a
# secret starts and fails to pull it. Scoped to the exact ARNs this service was given: a wildcard
# would let one service read every secret in the account.
data "aws_iam_policy_document" "execution_secrets" {
  count = length(var.secrets) > 0 ? 1 : 0

  statement {
    actions = ["secretsmanager:GetSecretValue"]
    # The JSON key selector is not part of the ARN, so the suffix is trimmed before it is granted.
    resources = distinct([
      for value in values(var.secrets) :
      length(regexall("^(arn:[^:]*:secretsmanager:[^:]*:[^:]*:secret:[^:]+)", value)) > 0
      ? regex("^(arn:[^:]*:secretsmanager:[^:]*:[^:]*:secret:[^:]+)", value)[0]
      : value
    ])
  }
}

resource "aws_iam_role_policy" "execution_secrets" {
  count  = length(var.secrets) > 0 ? 1 : 0
  name   = "${var.name}-execution-secrets"
  role   = aws_iam_role.execution.id
  policy = data.aws_iam_policy_document.execution_secrets[0].json

  lifecycle {
    replace_triggered_by = [aws_iam_role.execution.unique_id]
  }
}

resource "aws_iam_role" "task" {
  name                 = "${var.name}-task"
  permissions_boundary = var.permissions_boundary_arn
  path                 = var.iam_path
  assume_role_policy   = data.aws_iam_policy_document.task_assume.json
}

resource "aws_cloudwatch_log_group" "this" {
  name              = "/ecs/${var.name}"
  retention_in_days = 30
}

resource "aws_ecs_task_definition" "this" {
  family                   = var.name
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = var.task_cpu
  memory                   = var.task_memory
  execution_role_arn       = aws_iam_role.execution.arn
  task_role_arn            = aws_iam_role.task.arn

  runtime_platform {
    cpu_architecture        = var.cpu_architecture
    operating_system_family = "LINUX"
  }

  container_definitions = jsonencode([
    {
      name         = "app"
      image        = var.image
      essential    = true
      portMappings = [{ containerPort = var.container_port, protocol = "tcp" }]

      # Values the workload declares and the topology resolves: the database endpoint it connects
      # to, the port it listens on. Plain because none of them is a credential.
      environment = [
        for key in sort(keys(var.environment)) : {
          name  = key
          value = var.environment[key]
        }
      ]

      # Credentials, fetched by the execution role at task start rather than baked into the image
      # or into this file. Each valueFrom is a Secrets Manager ARN, optionally with a JSON key
      # selector -- an RDS-managed credential is a document, and the task wants one field of it.
      secrets = [
        for key in sort(keys(var.secrets)) : {
          name      = key
          valueFrom = var.secrets[key]
        }
      ]
      logConfiguration = {
        logDriver = "awslogs"
        options = {
          "awslogs-group"         = aws_cloudwatch_log_group.this.name
          "awslogs-region"        = var.region
          "awslogs-stream-prefix" = "app"
        }
      }
    }
  ])
}

resource "aws_ecs_service" "this" {
  name            = var.name
  cluster         = aws_ecs_cluster.this.id
  task_definition = aws_ecs_task_definition.this.arn
  desired_count   = var.initial_desired_count
  launch_type     = "FARGATE"

  network_configuration {
    subnets          = var.private_subnet_ids
    security_groups  = [aws_security_group.task.id]
    assign_public_ip = false
  }

  load_balancer {
    target_group_arn = aws_lb_target_group.this.arn
    container_name   = "app"
    container_port   = var.container_port
  }

  # A failed rollout is rolled back rather than left half-deployed.
  deployment_circuit_breaker {
    enable   = true
    rollback = true
  }

  # Whichever listeners exist: the plain-HTTP one, or the redirect and the TLS one.
  depends_on = [aws_lb_listener.http, aws_lb_listener.http_redirect, aws_lb_listener.https]

  # Created here, operated by delivery.
  #
  # The task definition and the task count both change on every release, and Terraform
  # re-asserting them would revert each deployment on the next apply -- and fight any
  # autoscaling policy besides. Ignoring them makes the boundary explicit: this module decides
  # the shape of the service, the pipeline decides what it runs and how much of it.
  lifecycle {
    ignore_changes = [task_definition, desired_count]
  }
}

locals {
  # Without a worker, none of the three resources below is created and the module is exactly
  # what it was. Existence is its own input: a command is an override, and a workload built from
  # its own Dockerfile already carries one in that image's CMD.
  worker_count = var.worker_enabled ? 1 : 0
}

# The background workload, which the estimate has always been charging for.
#
# Fargate is priced on serving tasks plus worker tasks, and this module created only the serving
# service -- so a repository with a web process and a queue consumer was quoted capacity for
# both, given infrastructure for one, and told its worker was "built and published but not
# deployed". Same image, different command: the queue consumer is the container's argument, not
# a separate build.
#
# No load balancer and no target group. A worker takes its work from a queue; nothing routes to
# it, and attaching it to the balancer would put a process that serves no HTTP behind a health
# check it cannot pass.
resource "aws_cloudwatch_log_group" "worker" {
  count             = local.worker_count
  name              = "/ecs/${var.name}-worker"
  retention_in_days = 30
}

resource "aws_ecs_task_definition" "worker" {
  count                    = local.worker_count
  family                   = "${var.name}-worker"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = var.worker_task_cpu
  memory                   = var.worker_task_memory
  execution_role_arn       = aws_iam_role.execution.arn
  task_role_arn            = aws_iam_role.task.arn

  runtime_platform {
    cpu_architecture        = var.cpu_architecture
    operating_system_family = "LINUX"
  }

  container_definitions = jsonencode([
    # The command is merged in rather than written with a default, because a workload built from
    # its own Dockerfile already declares one: restating it here would make this module a second
    # source of truth about how that image starts, and overriding it with an empty list would
    # stop it starting at all. A workload sharing the serving image does need one, because that
    # image starts the web server.
    merge(
      {
        name      = "worker"
        image     = var.image
        essential = true

        environment = [
          for key in sort(keys(var.environment)) : {
            name  = key
            value = var.environment[key]
          }
        ]

        secrets = [
          for key in sort(keys(var.secrets)) : {
            name      = key
            valueFrom = var.secrets[key]
          }
        ]
        logConfiguration = {
          logDriver = "awslogs"
          options = {
            "awslogs-group"         = aws_cloudwatch_log_group.worker[0].name
            "awslogs-region"        = var.region
            "awslogs-stream-prefix" = "worker"
          }
        }
      },
      length(var.worker_command) > 0 ? { command = var.worker_command } : {}
    )
  ])
}

resource "aws_ecs_service" "worker" {
  count           = local.worker_count
  name            = "${var.name}-worker"
  cluster         = aws_ecs_cluster.this.id
  task_definition = aws_ecs_task_definition.worker[0].arn
  desired_count   = var.initial_desired_count
  launch_type     = "FARGATE"

  network_configuration {
    subnets          = var.private_subnet_ids
    security_groups  = [aws_security_group.task.id]
    assign_public_ip = false
  }

  deployment_circuit_breaker {
    enable   = true
    rollback = true
  }

  # The same boundary the serving service draws: created here at zero tasks, raised by delivery
  # onto the revision delivery built.
  lifecycle {
    ignore_changes = [task_definition, desired_count]
  }
}
