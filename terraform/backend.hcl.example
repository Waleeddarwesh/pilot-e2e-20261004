# Generated by EgyKode Pilot (https://egykode.com) — review before merging.
# This file is a starting point, not a finished production configuration.
# Copy to backend.hcl, fill in the bucket the bootstrap module produced, then:
#
#     cp backend.hcl.example backend.hcl
#     terraform init -backend-config=backend.hcl

# The `state_bucket_name` output from ./bootstrap.
bucket = "REPLACE-ME-repo-tfstate-<account-id>-me-central-1"

# Give every environment its own key so one can never overwrite another.
key = "repo/development/terraform.tfstate"

region = "me-central-1"

# The `state_kms_key_arn` output from ./bootstrap. Without it Terraform falls back to the
# bucket default, which is the key this state is deliberately not sharing.
kms_key_id = "REPLACE-ME-state-kms-key-arn"
